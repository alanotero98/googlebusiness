---
import { Image } from 'astro:assets';
import portrait from '../assets/alan-otero.png';
import IconArrow from './IconArrow.astro';
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="container">
    

    <h1 class="hero__title" id="hero-title" data-reveal-lines>
      <span class="line"><span>Tu negocio</span></span>
      <span class="line"><span>merece una</span></span>
      <span class="line"><span><em>presencia digital</em></span></span>
      <span class="line"><span>a su <span class="u">altura.</span></span></span>
    </h1>

    <div class="hero__body">
      <p class="hero__lead" data-reveal style="--reveal-delay: 480ms">
        Diseño y desarrollo sitios web, tiendas online e integraciones digitales para que tu
        negocio consiga clientes, reciba reservas y trabaje mejor.
      </p>
      <div class="hero__actions" data-reveal style="--reveal-delay: 600ms">
        <a class="button button--solid hero__cta" href="#servicios">
          Explorar servicios
          <IconArrow />
        </a>
        <a class="button hero__cta" href="#contacto">
          Hablemos de tu proyecto
          <IconArrow />
        </a>
      </div>
    </div>

    <figure class="hero__portrait" data-reveal style="--reveal-delay: 320ms">
      <div class="hero__stage">
        <span class="hero__horizon" aria-hidden="true"></span>
        <div class="hero__flow" aria-hidden="true">
          <span class="hero__badge hero__badge--visitor">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="8" r="3.2"></circle>
              <path d="M5.5 19c0-3.3 2.9-6 6.5-6s6.5 2.7 6.5 6"></path>
            </svg>
          </span>
          <span class="hero__badge hero__badge--lead">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12.5l4.5 4.5L19 7.5"></path>
            </svg>
          </span>
          <span class="hero__particles"></span>
        </div>
        <div class="hero__circle">
          <div class="hero__frame">
            <Image
              class="hero__image"
              src={portrait}
              alt="Retrato de Alan Otero"
              widths={[320, 480, 640, 900, 1200]}
              sizes="(max-width: 768px) 76vw, 544px"
              format="webp"
              quality={82}
              priority
            />
          </div>
        </div>
      </div>
      <figcaption class="hero__caption">
        <span class="hero__caption-name">Alan Otero</span>
        <span aria-hidden="true">—</span>
        <span>Diseño web y soluciones digitales</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: 1vw;;
    padding-bottom: 0;
  }

  .hero__meta {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-3);
  }

  .hero__meta > :last-child {
    justify-self: end;
  }

  .hero__meta-center {
    justify-self: center;
    color: var(--ink);
  }

  .hero__title {
    max-width: 17ch;
    margin: clamp(2.5rem, 6vw, 5rem) auto 0;
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 11.5vw, 9.75rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-align: center;
    text-wrap: balance;
  }

  .hero__title em {
    font-style: italic;
    letter-spacing: -0.02em;
  }

  .hero__title .u {
    position: relative;
    display: inline-block;
  }

  .hero__title .u::after {
    content: '';
    position: absolute;
    left: 0.02em;
    right: 0.02em;
    bottom: 0.02em;
    height: 1px;
    background: currentColor;
    transform: scaleX(1);
    transform-origin: left;
    transition: transform 1.1s var(--ease-out) 0.9s;
  }

  .js .hero__title .u::after {
    transform: scaleX(0);
  }

  .js .hero__title.is-in .u::after {
    transform: scaleX(1);
  }

  .hero__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    margin-top: clamp(2rem, 4vw, 3.25rem);
    text-align: center;
  }

  .hero__lead {
    max-width: 46ch;
    color: var(--ink-2);
    font-size: clamp(1.12rem, 1.45vw, 1.3rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  .hero__portrait {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: clamp(3rem, 7vw, 5.5rem);
    margin-bottom: calc(-1 * var(--overlap));
  }

  .hero__stage {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
  }

  .hero__horizon {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100vw;
    height: 1px;
    background: var(--line);
    transform: translate(-50%, -50%);
  }

  .hero__flow {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 3;
    width: 100vw;
    height: 100%;
    transform: translateX(-50%);
    pointer-events: none;
    --in-end: 0px;
    --out-start: 0px;
    --out-end: 0px;
    --circle-size: 0px;
  }

  .hero__badge {
    position: absolute;
    top: 50%;
    left: 0;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-top: -1.125rem;
    border-radius: 50%;
    opacity: 0;
    will-change: transform, opacity;
    
  }

  .hero__badge svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .hero__badge--visitor {
    border: 2px solid var(--line);
    background: black;
    color: white;
  }

  .hero__badge--lead {
    border: 1px solid #10b981;
    background: #10b981;
    color: #ffffff;
  }

  .hero__flow.is-flowing .hero__badge--visitor {
    animation: heroVisitor 4s linear infinite;
  }

  .hero__flow.is-flowing .hero__badge--lead {
    animation: heroLead 4s linear infinite;
  }

  .hero__particles {
    position: absolute;
    inset: 0;
  }

  .hero__particle {
    position: absolute;
    width: var(--particle-size, 7px);
    height: var(--particle-size, 7px);
    border-radius: 50%;
    background: var(--particle-color, #111827);
    transform: translate(-50%, -50%);
    will-change: transform, opacity;
    animation: heroParticle 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero__ripple {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--circle-size, 0px);
    height: var(--circle-size, 0px);
    border: 1px solid #10b981;
    border-radius: 50%;
    transform: translate(-50%, -50%) scale(1);
    will-change: transform, opacity;
    animation: heroRipple 0.9s var(--ease-out) forwards;
  }

  .hero__frame.is-impact {
    animation: heroImpact 0.7s var(--ease-out);
  }

  @keyframes heroVisitor {
    0% {
      transform: translateX(0);
      opacity: 0;
    }
    6% {
      opacity: 1;
    }
    44% {
      opacity: 1;
    }
    48% {
      transform: translateX(var(--in-end));
      opacity: 0;
    }
    100% {
      transform: translateX(var(--in-end));
      opacity: 0;
    }
  }

  @keyframes heroLead {
    0%,
    50% {
      transform: translateX(var(--out-start));
      opacity: 0;
    }
    54% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    95% {
      transform: translateX(var(--out-end));
      opacity: 0;
    }
    100% {
      transform: translateX(var(--out-end));
      opacity: 0;
    }
  }

  @keyframes heroParticle {
    0% {
      transform: translate(-50%, -50%) translate(0, 0) scale(1);
      opacity: 1;
    }
    100% {
      transform: translate(-50%, -50%) translate(var(--dx), var(--dy)) scale(0.2);
      opacity: 0;
    }
  }

  @keyframes heroRipple {
    0% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.55;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.5);
      opacity: 0;
    }
  }

  @keyframes heroImpact {
    0% {
      transform: scale(1);
    }
    30% {
      transform: scale(1.08);
    }
    55% {
      transform: scale(0.985);
    }
    75% {
      transform: scale(1.02);
    }
    100% {
      transform: scale(1);
    }
  }

  .hero__circle {
    position: relative;
    z-index: 1;
    width: clamp(16.5rem, 74vw, 34rem);
    aspect-ratio: 1;
  }

  .hero__circle::before {
    content: '';
    position: absolute;
    inset: calc(-1 * clamp(0.6rem, 1.2vw, 1rem));
    border: 1px solid var(--line);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 50%;
    background: #efede8;
  }

  .hero__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 16%;
    filter: grayscale(1) contrast(1.03);
    transform: scale(1.015);
    transition: transform 1.8s var(--ease-out);
  }

  .js .hero__portrait:not(.is-in) .hero__frame :global(img) {
    transform: scale(1.08);
  }

  .hero__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    margin-top: clamp(3.1rem, 1vw, 1.5rem);
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.13em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero__caption-name {
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .hero__meta {
      grid-template-columns: 1fr 1fr;
    }

    .hero__meta-center {
      display: none;
    }

    .hero__title {
      max-width: 100%;
      margin-top: 2.25rem;
    }

    .hero__caption {
      max-width: 24ch;
    }
  }

  @media (max-width: 380px) {
    .hero__cta {
      width: 100%;
    }
  }
</style>

<script>
  (() => {
    const stage = document.querySelector('.hero__stage');
    const flow = stage?.querySelector('.hero__flow');
    const circle = stage?.querySelector('.hero__circle');
    const frame = stage?.querySelector('.hero__frame');
    const particlesLayer = stage?.querySelector('.hero__particles');
    const visitor = stage?.querySelector('.hero__badge--visitor');

    if (!stage || !flow || !circle || !frame || !particlesLayer || !visitor) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const CYCLE = 4000;
    const IMPACT_PHASE = 0.5;
    const PARTICLE_COUNT = 12;

    let geometry = { cx: 0, cy: 0, radius: 0 };
    let raf = 0;
    let running = false;
    let lastPhase = 0;
    let cycleStart = 0;

    const measure = () => {
      const flowRect = flow.getBoundingClientRect();
      const circleRect = circle.getBoundingClientRect();
      const badgeSize = visitor.getBoundingClientRect().width || 36;

      const inEnd = Math.max(0, circleRect.left - flowRect.left - badgeSize);
      const outStart = circleRect.right - flowRect.left;
      const outEnd = flowRect.width;

      flow.style.setProperty('--in-end', `${inEnd}px`);
      flow.style.setProperty('--out-start', `${outStart}px`);
      flow.style.setProperty('--out-end', `${outEnd}px`);
      flow.style.setProperty('--circle-size', `${circleRect.width}px`);

      geometry = {
        cx: circleRect.left - flowRect.left + circleRect.width / 2,
        cy: circleRect.top - flowRect.top + circleRect.height / 2,
        radius: circleRect.width / 2,
      };
    };

    const spawnParticles = () => {
      const { cx, cy, radius } = geometry;

      for (let i = 0; i < PARTICLE_COUNT; i += 1) {
        const angle = (i / PARTICLE_COUNT) * Math.PI * 2 + Math.PI / 12;
        const distance = 34 + Math.random() * 46;
        const particle = document.createElement('span');

        particle.className = 'hero__particle';
        particle.style.left = `${cx + Math.cos(angle) * radius}px`;
        particle.style.top = `${cy + Math.sin(angle) * radius}px`;
        particle.style.setProperty('--dx', `${Math.cos(angle) * distance}px`);
        particle.style.setProperty('--dy', `${Math.sin(angle) * distance}px`);
        particle.style.setProperty('--particle-color', i % 2 === 0 ? '#111827' : '#10b981');
        particle.style.setProperty('--particle-size', `${4 + Math.random() * 3}px`);

        particle.addEventListener('animationend', () => particle.remove(), { once: true });
        particlesLayer.appendChild(particle);
      }
    };

    const spawnRipple = () => {
      const ripple = document.createElement('span');
      ripple.className = 'hero__ripple';
      ripple.addEventListener('animationend', () => ripple.remove(), { once: true });
      flow.appendChild(ripple);
    };

    const impact = () => {
      measure();
      spawnRipple();
      spawnParticles();

      frame.classList.remove('is-impact');
      void frame.offsetWidth;
      frame.classList.add('is-impact');
    };

    frame.addEventListener('animationend', () => frame.classList.remove('is-impact'));

    const tick = (now) => {
      if (!running) return;

      const phase = ((now - cycleStart) % CYCLE) / CYCLE;
      if (lastPhase < IMPACT_PHASE && phase >= IMPACT_PHASE) impact();
      lastPhase = phase;

      raf = requestAnimationFrame(tick);
    };

    const start = () => {
      if (running || reduceMotion.matches) return;

      measure();
      lastPhase = 0;
      running = true;
      flow.classList.add('is-flowing');
      cycleStart = performance.now();
      raf = requestAnimationFrame(tick);
    };

    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
      flow.classList.remove('is-flowing');
      frame.classList.remove('is-impact');
      particlesLayer.replaceChildren();
    };

    const handleMotionChange = () => {
      if (reduceMotion.matches) stop();
      else start();
    };

    if (typeof ResizeObserver !== 'undefined') {
      const observer = new ResizeObserver(measure);
      observer.observe(circle);
      observer.observe(flow);
    }

    window.addEventListener('resize', measure);
    reduceMotion.addEventListener?.('change', handleMotionChange);

    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  })();
</script>
