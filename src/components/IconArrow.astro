---
interface Props {
  direction?: 'up-right' | 'right' | 'up';
  class?: string;
}

const { direction = 'up-right', class: className } = Astro.props;

const paths = {
  'up-right': 'M4.5 11.5 11.5 4.5M11.5 4.5H5.75M11.5 4.5V10.25',
  right: 'M2.5 8h11M9.5 4 13.5 8l-4 4',
  up: 'M8 13.5v-11M4 6.5 8 2.5l4 4',
} as const;
---

<svg
  class={className}
  viewBox="0 0 16 16"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <path
    d={paths[direction]}
    stroke="currentColor"
    stroke-width="1.15"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
