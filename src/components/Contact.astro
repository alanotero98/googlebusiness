---
import { siteConfig } from '../config';
import ContactForm from './ContactForm.astro';
import IconArrow from './IconArrow.astro';

const whatsapp = siteConfig.socials.find((social) => social.label === 'WhatsApp');
---

<section class="contact" id="contacto" aria-labelledby="contact-title">
  <div class="container contact__grid">
    <div class="contact__intro">
      <p class="eyebrow contact__eyebrow" data-reveal>(05) — Contacto</p>

      <h2 class="contact__title" id="contact-title" data-reveal style="--reveal-delay: 70ms">
        Hablemos de <em>tu negocio.</em>
      </h2>

      <p class="contact__lead" data-reveal style="--reveal-delay: 150ms">
        Contame qué hacés y qué necesitás. Podemos empezar por definir la solución digital
        adecuada para tu negocio.
      </p>

      <div class="contact__note" data-reveal style="--reveal-delay: 220ms">
        <p class="eyebrow">Cómo trabajo</p>
        <p>
          Primero entiendo tu negocio, después te propongo un plan. Sin paquetes genéricos ni
          promesas vacías.
        </p>
        {whatsapp && (
          <a
            class="text-link contact__whatsapp"
            href={whatsapp.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            Escribime por WhatsApp
            <IconArrow />
          </a>
        )}
        
      </div>
    </div>

    <div class="contact__form" data-reveal style="--reveal-delay: 120ms">
      <ContactForm />
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--section-y);
    border-top: 1px solid var(--line);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
  }

  .contact__intro {
    position: sticky;
    top: 7rem;
  }

  .contact__eyebrow {
    color: var(--ink-3);
  }

  .contact__title {
    max-width: 12ch;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 6vw, 6rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .contact__title em {
    font-style: italic;
    letter-spacing: -0.02em;
  }

  .contact__lead {
    max-width: 40ch;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--ink-2);
    font-size: clamp(1.08rem, 1.3vw, 1.22rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .contact__note {
    max-width: 36ch;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .contact__note .eyebrow {
    color: var(--ink-3);
  }

  .contact__note > p:not(.eyebrow) {
    margin-top: 0.75rem;
    color: var(--ink-3);
    font-size: 1rem;
    line-height: 1.62;
  }

  .contact__whatsapp {
    margin-top: 1.5rem;
  }

  .contact__whatsapp :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
  }

  .contact__note > p.contact__phone {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .contact__phone .eyebrow {
    color: var(--ink-3);
  }

  .contact__phone a {
    color: var(--ink);
    font-size: 1.0625rem;
  }

  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr;
      gap: clamp(3rem, 8vw, 4.5rem);
    }

    .contact__intro {
      position: static;
    }

    .contact__title {
      max-width: 14ch;
    }
  }
</style>
