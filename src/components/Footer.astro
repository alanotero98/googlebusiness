---
import { siteConfig } from '../config';
import IconArrow from './IconArrow.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <p class="eyebrow">{siteConfig.tagline}</p>
        <p class="footer__role">Diseño web y soluciones digitales para negocios.</p>
      </div>

      <nav class="footer__socials" aria-label="Redes sociales">
        {siteConfig.socials.map((social) => (
          <a href={social.href} target="_blank" rel="noopener noreferrer">
            {social.label}
            <IconArrow />
          </a>
        ))}
      </nav>
    </div>

    <a class="footer__wordmark" href="#inicio" aria-label="Alan Otero, volver al inicio">
      Alan Otero<span class="footer__dot" aria-hidden="true">.</span>
    </a>

    <div class="footer__bottom">
      <p>© {year} Alan Otero</p>
      <p class="footer__credit">Diseño y desarrollo — Alan Otero</p>
      <a class="footer__top-link" href="#inicio">
        Volver arriba
        <IconArrow direction="up" />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--ink);
    overflow: hidden;
  }

  .footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer__brand .eyebrow {
    color: var(--ink-3);
  }

  .footer__role {
    margin-top: 0.5rem;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .footer__socials a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-block: 0.25rem;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer__socials a::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }

  .footer__socials a:hover::after {
    transform: scaleX(1);
  }

  .footer__socials :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
    transition: transform 0.4s var(--ease-out);
  }

  .footer__socials a:hover :global(svg) {
    transform: translate(0.15rem, -0.15rem);
  }

  .footer__wordmark {
    display: block;
    margin-top: clamp(2.5rem, 6vw, 5rem);
    font-family: var(--font-serif);
    font-size: clamp(4.5rem, 19vw, 17rem);
    font-weight: 400;
    line-height: 0.78;
    letter-spacing: -0.05em;
    text-align: center;
    white-space: nowrap;
    transition: opacity 0.4s ease;
  }

  .footer__wordmark:hover {
    opacity: 0.65;
  }

  .footer__dot {
    display: inline-block;
    transition: transform 0.6s var(--ease-out);
  }

  .footer__wordmark:hover .footer__dot {
    transform: translateX(0.08em);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
  }

  .footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer__top-link :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
    transition: transform 0.4s var(--ease-out);
  }

  .footer__top-link:hover :global(svg) {
    transform: translateY(-0.2rem);
  }

  @media (max-width: 640px) {
    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer__credit {
      order: 3;
    }
  }
</style>
